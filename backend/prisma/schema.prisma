  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  durationSeconds  Float?
  storageUrl       String
  thumbnailUrl     String?
  aspectRatio      String?
  isUsed           Boolean  @default(false)
  altText          String?
  folderId         String?
  tags             String?  @db.Text
  source           String   @default("UPLOAD") // UPLOAD, UNSPLASH, PEXELS
