// Generated Metricool Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENTITIES
// ============================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  avatarUrl            String?
  phone                String?
  address              String?
  industry             String?
  bio                  String?   @db.Text
  role                 UserRole  @default(OWNER)
  customRoleId         String?
  isActive             Boolean   @default(true)
  isEmailVerified      Boolean   @default(false)
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean   @default(false)
  twoFactorBackupCodes String?   @db.Text
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  defaultBrandId       String?

  customRole               CustomRole?               @relation("UserCustomRole", fields: [customRoleId], references: [id])
  settings                 UserSettings?
  accounts                 UserAccount[]
  brands                   Brand[]                   @relation("BrandOwner")
  teamMembers              Team[]                    @relation("TeamMember")
  teamInviter              Team[]                    @relation("TeamInviter")
  createdPosts             Post[]                    @relation("PostCreator")
  createdLivestreams       Livestream[]              @relation("LivestreamCreator")
  createdReports           Report[]                  @relation("ReportCreator")
  auditLogs                AuditLog[]                @relation("AuditLogUser")
  notifications            SystemNotification[]
  notificationReadReceipts NotificationReadReceipt[]
  createdTickets           SupportTicket[]           @relation("TicketCreator")
  assignedTickets          SupportTicket[]           @relation("TicketAssignedAgent")
  ticketMessages           TicketMessage[]           @relation("TicketMessageSender")
  assignedInboxItems       InboxItem[]               @relation("InboxItemAssignedUser")
  repliedInboxItems        InboxItem[]               @relation("InboxItemRepliedBy")
  uploadedMedia            MediaLibrary[]            @relation("MediaLibraryUploader")
  approvalWorkflowRequests ApprovalWorkflow[]        @relation("ApprovalWorkflowRequester")
  workflowReviews          WorkflowReviewer[]        @relation("WorkflowReviewerUser")

  @@map("users")
}

model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  language String @default("vi")
  timezone String @default("Asia/Ho_Chi_Minh")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserAccount {
  id               String       @id @default(uuid())
  userId           String
  provider         AuthProvider
  providerId       String?
  passwordHash     String?
  twoFactorEnabled Boolean      @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_accounts")
}

model Brand {
  id                     String    @id @default(uuid())
  name                   String
  logoUrl                String?
  timezone               String
  defaultLanguage        String
  postsUsedThisMonth     Int       @default(0)
  engagementRatioFormula String    @default("(likes + comments + shares) / reach * 100")
  ownerId                String
  subscriptionId         String    @unique
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  owner                   User                         @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  subscription            Subscription                 @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  teamMembers             Team[]
  customRoles             CustomRole[]                 @relation("CustomRoleBrand")
  posts                   Post[]
  livestreams             Livestream[]
  contentCalendars        ContentCalendar[]
  bestTimeSlots           BestTimeSlot[]
  autoLists               AutoList[]
  approvalWorkflows       ApprovalWorkflow[]
  socialAccounts          SocialAccount[]
  adAccounts              AdAccount[]
  analytics               Analytics[]
  competitorAnalysis      CompetitorAnalysis[]
  facebookOverviewMetrics FacebookOverviewMetric[]
  facebookPostMetrics     FacebookPostMetric[]
  facebookStoryMetrics    FacebookStoryMetric[]
  unifiedInbox            UnifiedInbox[]
  reports                 Report[]
  smartLinks              SmartLink[]
  hashtagTrackers         HashtagTracker[]
  hashtagSets             HashtagSet[]
  aiAssistant             AIAssistant?
  reportScheduleConfig    ReportScheduleConfig?
  mediaLibrary            MediaLibrary[]
  mediaFolders            MediaFolder[]
  auditLogs               AuditLog[]
  notifications           SystemNotification[]
  subscriptionAddons      SubscriptionAddon[]
  supportTickets          SupportTicket[]
  trackedVideos           TrackedVideo[]
  calendarEvents          CalendarEvent[]
  livestreamHighlights    LivestreamHighlight[]
  postAnalyticsSnapshots  PostAnalyticsDailySnapshot[] @relation("BrandAnalyticsSnapshots")

  @@index([ownerId])
  @@map("brands")
}

model TrackedVideo {
  id           String       @id @default(uuid())
  brandId      String
  platform     PlatformType @default(YOUTUBE)
  videoId      String // YouTube Video ID
  title        String?
  thumbnailUrl String?
  channelId    String?
  channelName  String?
  publishedAt  DateTime?
  lastViews    Int          @default(0)
  lastLikes    Int          @default(0)
  lastComments Int          @default(0)
  isTracking   Boolean      @default(true)
  addedAt      DateTime     @default(now())
  lastSyncedAt DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, videoId])
  @@index([brandId])
  @@map("tracked_videos")
}

model Team {
  id              String     @id @default(uuid())
  brandId         String
  userId          String
  role            UserRole
  customRoleId    String?
  invitedByUserId String
  invitedAt       DateTime   @default(now())
  acceptedAt      DateTime?
  status          TeamStatus @default(PENDING)
  createdAt       DateTime   @default(now())

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user       User        @relation("TeamMember", fields: [userId], references: [id])
  invitedBy  User        @relation("TeamInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id])

  @@unique([brandId, userId])
  @@index([brandId])
  @@index([userId])
  @@map("teams")
}

model CustomRole {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  description String?
  colorHex    String
  createdAt   DateTime @default(now())

  brand       Brand                  @relation("CustomRoleBrand", fields: [brandId], references: [id])
  permissions CustomRolePermission[]
  teamMembers Team[]
  users       User[]                 @relation("UserCustomRole")

  @@index([brandId])
  @@map("custom_roles")
}

model CustomRolePermission {
  id            String  @id @default(uuid())
  roleId        String
  permissionKey String
  isAllowed     Boolean @default(true)

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@map("custom_role_permissions")
}

model SystemPermission {
  key         String   @id
  label       String
  description String?
  category    String   @default("management")
  createdAt   DateTime @default(now())

  @@map("system_permissions")
}

// ============================================
// EXTERNAL INTEGRATIONS
// ============================================

// Client credentials for external projects (e.g. Convo) authenticating to
// PubliCast via HMAC-signed requests. clientSecretEncrypted is stored
// encrypted (not hashed) because HMAC verification requires recomputing
// the signature from the plaintext secret — a one-way hash cannot be
// reversed the way a password hash can be left one-way. See
// src/utils/encryption.js (AES-256-GCM, same ENCRYPTION_KEY already used
// for social account OAuth tokens).
model IntegrationClient {
  id                    String    @id @default(uuid())
  name                  String
  clientId              String    @unique
  clientSecretEncrypted String
  // Previous secret, kept encrypted during a rotation's grace period so
  // verifyHmac() can accept requests signed with either secret while the
  // caller (Convo) updates its own ENV — see hmac-auth.middleware.js and
  // scripts/rotate-integration-secret.js. Null outside of an active
  // rotation grace window.
  clientSecretPrevEncrypted String?
  secretRotatedAt           DateTime?
  secretPrevExpiresAt       DateTime?
  // Where PubliCast POSTs HMAC-signed revocation events (user removed from
  // brand / brand deactivated) — see revocation-webhook.service.js.
  // Nullable: a client that only calls verify-token/user-permissions
  // inbound has no reason to also receive outbound webhooks yet.
  webhookUrl            String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  revokedAt             DateTime?

  @@index([clientId])
  @@map("integration_clients")
}

// Audit trail for IntegrationClient secret rotations — SPEC.md §8. Kept as
// its own append-only table rather than versioning IntegrationClient rows,
// since a rotation is an event to record, not client state to query.
model IntegrationSecretRotationLog {
  id            String   @id @default(uuid())
  clientId      String
  reason        String   // 'SCHEDULED' | 'COMPROMISED'
  gracePeriodMs Int
  rotatedAt     DateTime @default(now())
  rotatedBy     String   // hostname/user running the CLI script, for accountability

  @@index([clientId])
  @@map("integration_secret_rotation_logs")
}

// ============================================
// BILLING & SUBSCRIPTION
// ============================================

model Plan {
  id              String           @id @default(uuid())
  name            PlanName
  priceAmount     Decimal
  currency        String
  billingCycle    BillingCycle
  description     String?
  planLimitId     String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  pendingPayments PendingPayment[]
  planLimit       PlanLimit        @relation(fields: [planLimitId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  products        Product[]        @relation("PlanProducts")

  @@unique([name, billingCycle])
  @@map("plans")
}

model Platform {
  id        String    @id // e.g. "YT", "FB", "TK"
  name      String    @unique
  color     String    @default("#000000")
  image     String?   @db.LongText // Base64 or URL
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("platforms")
}

model Module {
  id          String    @id // e.g. "M1", "M2"
  name        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("modules")
}

model Product {
  id         String   @id // Uses semantic slug (e.g. 'youtube_analytics' or 'yt_m1')
  name       String   @unique
  category   String // e.g. 'Platforms', 'AI Tools'
  platformId String?
  moduleId   String?
  sku        String?  @unique
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())

  platform Platform? @relation(fields: [platformId], references: [id], onDelete: Cascade)
  module   Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plans    Plan[]    @relation("PlanProducts")

  @@map("products")
}

model PlanLimit {
  id                    String        @id @default(uuid())
  maxBrands             Int
  maxSocialProfiles     Int
  maxPostsPerMonth      Int
  maxLivePlatforms      Int
  maxStreamQuality      StreamQuality
  maxTeamSeats          Int
  allowCustomRoles      Boolean
  allowApprovalWorkflow Boolean
  createdAt             DateTime      @default(now())

  plans Plan[]

  @@map("plan_limits")
}

model Subscription {
  id                   String             @id @default(uuid())
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  plan     Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  brand    Brand?
  addons   SubscriptionAddon[]
  invoices Invoice[]

  @@index([planId])
  @@map("subscriptions")
}

model Addon {
  id            String   @id @default(uuid())
  name          String
  type          String
  priceAmount   Decimal
  currency      String
  value         Int
  stripePriceId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions   SubscriptionAddon[]
  pendingPayments PendingPayment[]

  @@map("addons")
}

model SubscriptionAddon {
  id                       String   @id @default(uuid())
  subscriptionId           String
  addonId                  String
  quantity                 Int
  status                   String   @default("ACTIVE")
  currentPeriodEnd         DateTime
  stripeSubscriptionItemId String?
  createdAt                DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon        Addon        @relation(fields: [addonId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String?

  @@unique([subscriptionId, addonId])
  @@map("subscription_addons")
}

model Invoice {
  id              String    @id @default(uuid())
  subscriptionId  String
  amount          Decimal
  currency        String
  pdfUrl          String
  status          String
  transactionCode String?
  issuedAt        DateTime
  paidAt          DateTime?
  dueAt           DateTime?
  createdAt       DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("invoices")
}

// Tracks VietQR payments before SePay confirms them via webhook
model PendingPayment {
  id              String    @id @default(uuid())
  transactionCode String    @unique // e.g. PUBLICAST-PRO-ABC12345-1719350400000
  planId          String?
  addonId         String?
  addonQuantity   Int?
  brandId         String
  amount          Decimal
  currency        String    @default("VND")
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | UNDERPAID
  expiredAt       DateTime
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  plan  Plan?  @relation(fields: [planId], references: [id])
  addon Addon? @relation(fields: [addonId], references: [id])

  @@index([brandId])
  @@index([status])
  @@map("pending_payments")
}

// ============================================
// SOCIAL MEDIA PLATFORMS
// ============================================

enum SyncStatus {
  PENDING
  PARTIAL
  SUCCESS
  FAILED
}

model SocialAccount {
  id                String       @id @default(uuid())
  brandId           String
  platform          PlatformType
  platformAccountId String
  username          String
  displayName       String
  profilePictureUrl String?      @db.Text
  accessToken       String       @db.Text
  refreshToken      String?      @db.Text
  tokenExpiresAt    DateTime?
  scopes            String       @db.Text
  isConnected       Boolean      @default(true)
  connectedAt       DateTime
  lastSyncAt        DateTime?
  syncStatus        SyncStatus   @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  analytics        Analytics[]
  inboxItems       InboxItem[]
  instagramAccount InstagramAccount?
  facebookPage     FacebookPage?
  tikTokAccount    TikTokAccount?
  youtubeChannel   YouTubeChannel?
  telegramAccount  TelegramAccount?
  autoReplySetting AutoReplySetting?

  // Facebook dedicated metrics
  facebookOverviewMetrics FacebookOverviewMetric[] @relation("FacebookOverviewMetricAccount")
  facebookPostMetrics     FacebookPostMetric[]     @relation("FacebookPostMetricAccount")
  facebookStoryMetrics    FacebookStoryMetric[]    @relation("FacebookStoryMetricAccount")

  @@unique([brandId, platform, platformAccountId])
  @@index([brandId])
  @@map("social_accounts")
}

model YouTubeChannel {
  id                    String  @id @default(uuid())
  socialAccountId       String  @unique
  channelId             String // ID gốc từ YouTube (UCxxxxxxxx)
  customUrl             String? // @handle
  uploadsPlaylistId     String? // ID của playlist chứa video tải lên
  subscribersCount      Int     @default(0)
  totalVideosCount      Int     @default(0)
  totalViewsCount       Int     @default(0)
  country               String?
  defaultLanguage       String?
  isVerified            Boolean @default(false)
  isMonetized           Boolean @default(false)
  supportsShorts        Boolean @default(true)
  supportsLivestream    Boolean @default(false)
  madeForKids           Boolean @default(false)
  hiddenSubscriberCount Boolean @default(false)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("youtube_channels")
}

model InstagramAccount {
  id                    String  @id @default(uuid())
  socialAccountId       String  @unique
  accountType           String
  businessCategoryName  String?
  followersCount        Int     @default(0)
  followingCount        Int     @default(0)
  mediaCount            Int     @default(0)
  biography             String?
  website               String?
  supportsStories       Boolean @default(false)
  supportsReels         Boolean @default(false)
  supportsCarousels     Boolean @default(false)
  supportsCollaboration Boolean @default(false)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("instagram_accounts")
}

model FacebookPage {
  id              String  @id @default(uuid())
  socialAccountId String  @unique
  pageId          String
  category        String?
  likesCount      Int     @default(0)
  followersCount  Int     @default(0)
  about           String?
  website         String?
  isPublished     Boolean @default(true)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("facebook_pages")
}

model TikTokAccount {
  id                String  @id @default(uuid())
  socialAccountId   String  @unique
  followersCount    Int     @default(0)
  followingCount    Int     @default(0)
  likesCount        Int     @default(0)
  videoCount        Int     @default(0)
  isVerified        Boolean @default(false)
  supportsCarousels Boolean @default(false)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("tiktok_accounts")
}

model TelegramAccount {
  id              String @id @default(uuid())
  socialAccountId String @unique
  chatType        String @default("channel") // "channel" or "group"
  memberCount     Int    @default(0)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}

model AdAccount {
  id                String         @id @default(uuid())
  brandId           String
  platform          AdPlatformType
  platformAccountId String
  accountName       String
  currency          String
  timezone          String
  accessToken       String
  isActive          Boolean        @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime       @default(now())

  brand     Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  analytics Analytics[]

  @@unique([brandId, platform, platformAccountId])
  @@index([brandId])
  @@map("ad_accounts")
}

// ============================================
// CONTENT MANAGEMENT
// ============================================

model Post {
  id                 String     @id @default(uuid())
  brandId            String
  createdByUserId    String
  title              String
  caption            String?    @db.Text
  type               PostType
  status             PostStatus @default(DRAFT)
  // Persisted count of self-enqueued partial-retry rounds (mirrors the
  // in-memory partialRetryCount that only lives in BullMQ job.data — if that
  // job is ever lost (Redis restart, or the #106 active-job dedup skipping a
  // re-enqueue), this is what the RETRYING reconciler sweeper reads to decide
  // whether to re-enqueue again or give up as FAILED (#107 I7).
  publishRetryCount  Int        @default(0)
  targetPlatforms    String     @db.Text
  mediaUrls          String?    @db.Text
  mediaThumbnailUrls String?    @db.Text
  hashtags           String?    @db.Text
  mentions           String?    @db.Text
  firstComment       String?    @db.Text
  locationId         String?
  locationName       String?
  linkUrl            String?
  altText            String?
  metadata           String?    @db.Text
  isCollaboration    Boolean    @default(false)
  collaboratorHandle String?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  failureReason      String?    @db.Text
  autoListId         String?
  platformPostId     String?
  isLibrary          Boolean    @default(false)
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator           User               @relation("PostCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  autoList          AutoList?          @relation(fields: [autoListId], references: [id], onDelete: Cascade)
  approvalWorkflows ApprovalWorkflow[]

  postAnalyticsSnapshots PostAnalyticsDailySnapshot[] @relation("PostAnalyticsSnapshots")

  @@index([brandId])
  @@index([createdByUserId])
  @@map("posts")
}

model PostAnalyticsDailySnapshot {
  id             String       @id @default(uuid())
  postId         String?
  platformPostId String
  brandId        String
  platform       PlatformType
  date           DateTime     @db.Date // UTC-normalized day

  viewsCumulative     Int @default(0)
  reachCumulative     Int @default(0)
  clicksCumulative    Int @default(0)
  reactionsCumulative Int @default(0)

  isEstimated Boolean  @default(false) // true for carry-forward/baseline-seeded rows
  createdAt   DateTime @default(now())

  post  Post? @relation("PostAnalyticsSnapshots", fields: [postId], references: [id], onDelete: Cascade)
  brand Brand @relation("BrandAnalyticsSnapshots", fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([platformPostId, date])
  @@index([brandId, date])
  @@index([postId])
  @@map("post_analytics_daily_snapshot")
}

model Livestream {
  id               String   @id @default(uuid())
  brandId          String
  createdByUserId  String
  title            String
  description      String?
  thumbnailUrl     String?
  scheduledAt      DateTime
  durationMinutes  Int
  status           String   @default("DRAFT")
  platformStreamId String?  @db.VarChar(255)
  metadata         String?  @db.Text
  streamKey        String
  rtmpUrl          String
  targetPlatforms  String   @db.Text
  streamQuality    String   @db.Text
  requireApproval  Boolean  @default(false)
  peakViewers      Int      @default(0)
  totalViews       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator           User               @relation("LivestreamCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvalWorkflows ApprovalWorkflow[]

  @@index([brandId])
  @@index([scheduledAt])
  @@map("livestreams")
}

model ContentCalendar {
  id               String       @id @default(uuid())
  brandId          String       @unique
  defaultView      CalendarView @default(MONTH)
  countryCalendars String?      @db.Text
  showBestTimes    Boolean      @default(true)
  filterPlatforms  String?      @db.Text
  filterStatuses   String?      @db.Text
  createdAt        DateTime     @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("content_calendars")
}

model BestTimeSlot {
  id              String       @id @default(uuid())
  brandId         String
  platform        PlatformType
  dayOfWeek       Int
  hour            Int
  engagementScore Float
  confidenceLevel String
  calculatedAt    DateTime

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform, dayOfWeek, hour])
  @@index([brandId])
  @@map("best_time_slots")
}

model AutoList {
  id                  String         @id @default(uuid())
  brandId             String
  name                String
  sourceType          ListSourceType
  rssUrl              String?
  csvLastUploadedAt   DateTime?
  targetPlatforms     String         @db.Text
  scheduleType        String
  intervalMinutes     Int?
  specificTimes       String?        @db.Text
  activeDays          String         @db.Text
  lastPostedAt        DateTime?
  useAITimes          Boolean        @default(false)
  lowQueueAlert       Boolean        @default(true)
  queueThreshold      Int            @default(5)
  isActive            Boolean        @default(true)
  loopEnabled         Boolean        @default(false)
  totalPostsCount     Int            @default(0)
  publishedPostsCount Int            @default(0)
  metadata            String?        @db.Text
  createdAt           DateTime       @default(now())

  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([brandId])
  @@map("auto_lists")
}

model ApprovalWorkflow {
  id                String         @id @default(uuid())
  postId            String?
  livestreamId      String?
  brandId           String
  requesterId       String
  approvalPolicy    ApprovalPolicy
  selectedReviewers String?        @db.Text
  reviewedByUserId  String?
  status            WorkflowStatus @default(PENDING)
  requesterNote     String?        @db.Text
  reviewerComment   String?        @db.Text
  revisionNote      String?        @db.Text
  requestedAt       DateTime       @default(now())
  reviewedAt        DateTime?
  version           Int            @default(1)

  post       Post?              @relation(fields: [postId], references: [id], onDelete: Cascade)
  livestream Livestream?        @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requester  User               @relation("ApprovalWorkflowRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewers  WorkflowReviewer[]

  @@index([brandId])
  @@map("approval_workflows")
}

model WorkflowReviewer {
  id         String         @id @default(uuid())
  workflowId String
  reviewerId String
