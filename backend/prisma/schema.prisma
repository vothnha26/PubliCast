// Separate from InstagramPostMetric — Threads reach/views are always null
// (no real API source), kept as their own nullable columns rather than
// forcing Instagram's non-nullable shape onto Threads' lesser data.
model ThreadsPostMetric {
  id              String    @id @default(uuid())
  brandId         String
  socialAccountId String
  platformPostId  String
  publishedAt     DateTime?

  reach   Int? // always null today — no Threads API source exists
  views   Int? // always null today — no Threads API source exists
  likes   Int  @default(0)
  replies Int  @default(0)
  reposts Int  @default(0)
  clicks  Int  @default(0)

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([socialAccountId, platformPostId, fetchedAt])
  @@map("threads_post_metrics")
}

// Reduced shape per product decision — AT Protocol has no reach/impressions
// concept for a post, so those columns are omitted entirely rather than
// stored as always-0 placeholders.
model BlueskyPostMetric {
  id              String    @id @default(uuid())
  brandId         String
  socialAccountId String
  platformPostId  String
  publishedAt     DateTime?

  likes   Int @default(0)
  replies Int @default(0)
  reposts Int @default(0)
  quotes  Int @default(0)

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([socialAccountId, platformPostId, fetchedAt])
  @@map("bluesky_post_metrics")
}

// V2 = append-only replacement for FacebookPostMetric (which stays in place,
// still upsert-only, during the dual-write migration window — see §4 step 4
// of the analytics redesign doc). Once callers cut over to reading V2,
// FacebookPostMetric can be dropped in a follow-up migration.
model FacebookPostMetricV2 {
  id              String    @id @default(uuid())
  brandId         String
  socialAccountId String
  platformPostId  String
  postType        String?
  publishedAt     DateTime?

  reach          Int   @default(0)
  impressions    Int   @default(0)
  videoViews     Int   @default(0)
  likes          Int   @default(0)
  comments       Int   @default(0)
  shares         Int   @default(0)
  reactions      Int   @default(0)
  linkClicks     Int   @default(0)
  otherClicks    Int   @default(0)
  engagementRate Float @default(0)

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([socialAccountId, platformPostId, fetchedAt])
  @@map("facebook_post_metrics_v2")
}

