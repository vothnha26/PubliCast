model MediaFolder {
  id        String   @id @default(uuid())
  brandId   String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
