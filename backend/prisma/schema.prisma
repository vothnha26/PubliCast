}

enum ApprovalPolicy {
  AT_LEAST_ONE
  ALL
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  INSTAGRAM
}

model PlatformLimit {
  id                String       @id @default(uuid())
  platform          PlatformType // e.g. YOUTUBE, FACEBOOK, INSTAGRAM, TIKTOK, TELEGRAM
  subType           String // e.g. "POST", "REEL", "STORY", "VIDEO", "SHORTS"
  maxCaptionLength  Int          @default(2000)
  maxFileSizeMb     Int          @default(100) // 100MB
  allowedMediaTypes String       @default("ALL") // "ALL", "IMAGE", "VIDEO", "NONE"
  allowedFormats    String       @default("mp4,mov,png,jpg,jpeg")
  minVideoDuration  Int? // in seconds
  maxVideoDuration  Int? // in seconds
  aspectRatios      String? // e.g. "9:16,16:9"
  isLocked          Boolean      @default(false) // Admin co the tam khoa nen tang
  lockReason        String? // Ly do khoa hien thi cho nguoi dung
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([platform, subType])
}

model AutoReplySetting {
  id              String   @id @default(uuid())
  socialAccountId String   @unique
  isActive        Boolean  @default(false)
  mode            String   @default("KEYWORD") // "KEYWORD" or "AI"
  keywordsConfig  Json? // e.g. [{"keywords": ["giá", "inbox"], "reply": "Dạ..."}]
  aiPrompt        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("auto_reply_settings")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  brandId     String? // Nullable if global system events (holidays)
  title       String
  description String?  @db.Text
  eventDate   DateTime // Date of the event
  isSystem    Boolean  @default(false) // If true, it is a global holiday
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("calendar_events")
}

model LivestreamHighlight {
  id             String   @id @default(uuid())
  brandId        String
  youtubeUrl     String
  status         String   @default("pending")
  progress       Int      @default(0)
  progressMsg    String?
  videoUrl       String?  @db.Text
  subtitleUrl    String?  @db.Text
  duration       Float?
  youtubeVideoId String? // ID video sau khi đăng lên YouTube Shorts
  createdAt      DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("livestream_highlights")
}

// ============================================
// OUTBOX PATTERN (transactional side-effect delivery)
// ============================================

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {
  id          String            @id @default(uuid())
  eventType   String // vd 'POST_PUBLISH_UPSERT', xem OUTBOX_EVENT_TYPES
  aggregateId String // vd postId - dùng để dedupe/trace, KHÔNG dùng làm khóa unique cưỡng bức
  payload     String            @db.Text // JSON.stringify
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  maxAttempts Int               @default(5)
  nextRunAt   DateTime          @default(now()) // dispatcher chỉ pick WHERE nextRunAt <= now()
  lastError   String?           @db.Text
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, nextRunAt])
  @@index([status, updatedAt])
  @@index([aggregateId])
  @@index([eventType])
  @@map("outbox_events")
}
