  THREADS
  BLUESKY
  GOOGLE_BUSINESS
  TELEGRAM
}

enum AdPlatformType {
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
}

enum PostType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
  STORY
  SHORT
  THREAD
  PIN
  TIKTOK_CAROUSEL
  // Facebook-specific post types
  LINK // Bài đăng chỉ có link preview (không có media)
  TEXT // Bài đăng thuần text, không media
  LIVE_VIDEO // Video phát trực tiếp (đã kết thúc, lưu lại)
  ALBUM // Album ảnh nhiều trang (legacy Facebook)
}

/// Phân loại nội dung Facebook dùng riêng cho analytics.
/// Map 1-1 với cột "Group" trong Types panel (ảnh tham chiếu).
/// Khác với PostType (dùng để tạo bài) — đây là để phân tích sau khi publish.
enum FacebookPostType {
  IMAGE // Ảnh đơn
  VIDEO // Video thường
  REEL // Facebook Reel (short-form video)
  LINK // Post có link/URL preview
  TEXT // Post thuần text, không media
  CAROUSEL // Nhiều ảnh/video dạng slideshow
  ALBUM // Album ảnh truyền thống
  LIVE_VIDEO // Video Live đã được lưu lại
  STORY // Facebook Story (khi thống kê cùng batch với posts)
}

enum PostStatus {
