model UnifiedInbox {
  id              String    @id @default(uuid())
  brandId         String    @unique
  totalUnread     Int       @default(0)
  lastSyncAt      DateTime?
  filterPlatforms String?   @db.Text
  filterTypes     String?   @db.Text
  createdAt       DateTime  @default(now())

  brand Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items InboxItem[]

  @@map("unified_inboxes")
}

model InboxItem {
  id                      String        @id @default(uuid())
  inboxId                 String
  platform                PlatformType
  type                    InboxItemType
  platformItemId          String        @unique
  authorId                String
  authorName              String
  authorAvatarUrl         String?
  content                 String        @db.Text
  mediaUrls               String?       @db.Text
  relatedPostId           String? // ID bài viết/video từ nền tảng gốc
  parentItemId            String?
  // Raw platform parent id, set only when the parent comment hasn't been
  // ingested yet (out-of-order webhook delivery). Reconciled to parentItemId
  // once the parent's own webhook arrives and upserts a matching row (#100).
  pendingParentPlatformId String?
  assignedUserId          String?
  tags                    Json? // Mảng nhãn phân loại tùy chỉnh (VIP, Hỏi giá...)
  internalNotes           Json? // Lịch sử ghi chú nội bộ của các nhân viên hỗ trợ
  status                  String        @default("UNREAD")
  isHidden                Boolean       @default(false)
  sentiment               String?
  repliedByUserId         String?
  repliedAt               DateTime?
  platformCreatedAt       DateTime
  syncedAt                DateTime
  createdAt               DateTime      @default(now())

  inbox           UnifiedInbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  parentItem      InboxItem?     @relation("InboxItemReplies", fields: [parentItemId], references: [id])
  replies         InboxItem[]    @relation("InboxItemReplies")
  assignedUser    User?          @relation("InboxItemAssignedUser", fields: [assignedUserId], references: [id])
  repliedBy       User?          @relation("InboxItemRepliedBy", fields: [repliedByUserId], references: [id])
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  socialAccountId String?

  @@index([inboxId])
  @@index([relatedPostId])
  @@index([pendingParentPlatformId])
  @@map("inbox_items")
}

model SupportTicket {
  id              String   @id @default(uuid())
  brandId         String
  userId          String
  subject         String
  status          String   @default("OPEN")
  priority        String
  assignedAgentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user          User            @relation("TicketCreator", fields: [userId], references: [id], onDelete: Restrict)
  assignedAgent User?           @relation("TicketAssignedAgent", fields: [assignedAgentId], references: [id])
  messages      TicketMessage[]

  @@index([brandId])
  @@map("support_tickets")
}

model TicketMessage {
