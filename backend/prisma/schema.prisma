// Generated Metricool Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENTITIES
// ============================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  avatarUrl            String?
  phone                String?
  address              String?
  industry             String?
  bio                  String?   @db.Text
  role                 UserRole  @default(OWNER)
  customRoleId         String?
  isActive             Boolean   @default(true)
  isEmailVerified      Boolean   @default(false)
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean   @default(false)
  twoFactorBackupCodes String?   @db.Text
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  defaultBrandId       String?

  customRole               CustomRole?               @relation("UserCustomRole", fields: [customRoleId], references: [id])
  settings                 UserSettings?
  accounts                 UserAccount[]
  brands                   Brand[]                   @relation("BrandOwner")
  teamMembers              Team[]                    @relation("TeamMember")
  teamInviter              Team[]                    @relation("TeamInviter")
  createdPosts             Post[]                    @relation("PostCreator")
  createdReports           Report[]                  @relation("ReportCreator")
  auditLogs                AuditLog[]                @relation("AuditLogUser")
  notifications            SystemNotification[]
  notificationReadReceipts NotificationReadReceipt[]
  createdChannelGroups     ChannelGroup[]
  createdTickets           SupportTicket[]           @relation("TicketCreator")
  assignedTickets          SupportTicket[]           @relation("TicketAssignedAgent")
  ticketMessages           TicketMessage[]           @relation("TicketMessageSender")
  assignedInboxItems       InboxItem[]               @relation("InboxItemAssignedUser")
  repliedInboxItems        InboxItem[]               @relation("InboxItemRepliedBy")
  uploadedMedia            MediaLibrary[]            @relation("MediaLibraryUploader")
  approvalWorkflowRequests ApprovalWorkflow[]        @relation("ApprovalWorkflowRequester")
  workflowReviews          WorkflowReviewer[]        @relation("WorkflowReviewerUser")

  @@map("users")
}

model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  language String @default("vi")
  timezone String @default("Asia/Ho_Chi_Minh")

  // Master toggle — overrides every category switch below when false,
  // without needing to clear each one individually (mirrors Buffer's
  // "Unsubscribe from all" behavior).
  notificationsEnabled    Boolean @default(true)
  notifyPostFailure       Boolean @default(true)
  notifyPublishSuccess    Boolean @default(true)
  notifyChannelDisconnect Boolean @default(true)
  notifyCollaboration     Boolean @default(true)
  notifyBilling           Boolean @default(true)
  notifyEmptyQueue        Boolean @default(true)
  notifyDailyRecap        Boolean @default(false)
  notifyWeeklyReport      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserAccount {
  id               String       @id @default(uuid())
  userId           String
  provider         AuthProvider
  providerId       String?
  passwordHash     String?
  twoFactorEnabled Boolean      @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_accounts")
}

model Brand {
  id                     String    @id @default(uuid())
  name                   String
  logoUrl                String?
  timezone               String
  defaultLanguage        String
  postsUsedThisMonth     Int       @default(0)
  engagementRatioFormula String    @default("(likes + comments + shares) / reach * 100")
  ownerId                String
  subscriptionId         String    @unique
  isActive               Boolean   @default(true)
  onboardingCompleted    Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  owner                     User                       @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  subscription              Subscription               @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  teamMembers               Team[]
  customRoles               CustomRole[]               @relation("CustomRoleBrand")
  posts                     Post[]
  contentCalendars          ContentCalendar[]
  bestTimeSlots             BestTimeSlot[]
  autoLists                 AutoList[]
  approvalWorkflows         ApprovalWorkflow[]
  socialAccounts            SocialAccount[]
  channelGroups             ChannelGroup[]
  adAccounts                AdAccount[]
  analytics                 Analytics[]
  competitorAnalysis        CompetitorAnalysis[]
  facebookPostMetrics       FacebookPostMetric[]
  socialPostMetrics         SocialPostMetric[]
  youtubeChannelSnapshots   YouTubeChannelSnapshot[]
  tiktokChannelSnapshots    TikTokChannelSnapshot[]
  instagramChannelSnapshots InstagramChannelSnapshot[]
  threadsChannelSnapshots   ThreadsChannelSnapshot[]
  blueskyChannelSnapshots   BlueskyChannelSnapshot[]
  facebookChannelSnapshots  FacebookChannelSnapshot[]
  youtubeVideoMetrics       YouTubeVideoMetric[]
  tiktokVideoMetrics        TikTokVideoMetric[]
  instagramPostMetrics      InstagramPostMetric[]
  threadsPostMetrics        ThreadsPostMetric[]
  blueskyPostMetrics        BlueskyPostMetric[]
  facebookPostMetricsV2     FacebookPostMetricV2[]
  unifiedInbox              UnifiedInbox[]
  reports                   Report[]
  smartLinks                SmartLink[]
  hashtagTrackers           HashtagTracker[]
  hashtagSets               HashtagSet[]
  postingGoals              PostingGoal[]
  streak                    BrandStreak?
  feedSources               FeedSource[]
  aiAssistant               AIAssistant?
  reportScheduleConfig      ReportScheduleConfig?
  mediaLibrary              MediaLibrary[]
  mediaFolders              MediaFolder[]
  auditLogs                 AuditLog[]
  notifications             SystemNotification[]
  subscriptionAddons        SubscriptionAddon[]
  supportTickets            SupportTicket[]
  trackedVideos             TrackedVideo[]
  youtubePlaylistCache      YouTubePlaylistCache[]
  calendarEvents            CalendarEvent[]

  @@index([ownerId])
  @@map("brands")
}

model TrackedVideo {
  id           String       @id @default(uuid())
  brandId      String
  platform     PlatformType @default(YOUTUBE)
  videoId      String // YouTube Video ID
  title        String?
  thumbnailUrl String?
  channelId    String?
  channelName  String?
  publishedAt  DateTime?
  lastViews    Int          @default(0)
  lastLikes    Int          @default(0)
  lastComments Int          @default(0)
  isTracking   Boolean      @default(true)
  addedAt      DateTime     @default(now())
  lastSyncedAt DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, videoId])
  @@index([brandId])
  @@map("tracked_videos")
}

model YouTubeVideoCategory {
  id         String   @id @default(uuid())
  regionCode String
  categoryId String // ID gốc từ YouTube (vd "22")
  title      String
  syncedAt   DateTime @default(now())

  @@unique([regionCode, categoryId])
  @@index([regionCode])
  @@map("youtube_video_categories")
}

model YouTubePlaylistCache {
  id              String   @id @default(uuid())
  brandId         String
  // Which YouTube channel these playlists belong to — nullable because rows
  // written before this column existed have no way to know; those are
  // treated as belonging to the brand's first/default YouTube account (see
  // youtube-video.service.js's cache lookup fallback). A brand with multiple
  // YouTube channels needs this to avoid serving one channel's playlists
  // from another's cache.
  socialAccountId String?
  playlistId      String // ID gốc từ YouTube
  title           String
  description     String?  @db.Text
  itemCount       Int      @default(0)
  syncedAt        DateTime @default(now())

  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([brandId, socialAccountId, playlistId])
  @@index([brandId])
  @@index([socialAccountId])
  @@map("youtube_playlist_cache")
}

model Team {
  id              String     @id @default(uuid())
  brandId         String
  userId          String
  role            UserRole
  customRoleId    String?
  invitedByUserId String
  invitedAt       DateTime   @default(now())
  acceptedAt      DateTime?
  status          TeamStatus @default(PENDING)
  createdAt       DateTime   @default(now())

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user       User        @relation("TeamMember", fields: [userId], references: [id])
  invitedBy  User        @relation("TeamInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id])

  @@unique([brandId, userId])
  @@index([brandId])
  @@index([userId])
  @@map("teams")
}

model CustomRole {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  description String?
  colorHex    String
  createdAt   DateTime @default(now())

  brand       Brand                  @relation("CustomRoleBrand", fields: [brandId], references: [id])
  permissions CustomRolePermission[]
  teamMembers Team[]
  users       User[]                 @relation("UserCustomRole")

  @@index([brandId])
  @@map("custom_roles")
}

model CustomRolePermission {
  id            String  @id @default(uuid())
  roleId        String
  permissionKey String
  isAllowed     Boolean @default(true)

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@map("custom_role_permissions")
}

model SystemPermission {
  key         String   @id
  label       String
  description String?
  category    String   @default("management")
  createdAt   DateTime @default(now())

  @@map("system_permissions")
}

// ============================================
// EXTERNAL INTEGRATIONS
// ============================================

// Client credentials for external projects (e.g. Convo) authenticating to
// PubliCast via HMAC-signed requests. clientSecretEncrypted is stored
// encrypted (not hashed) because HMAC verification requires recomputing
// the signature from the plaintext secret — a one-way hash cannot be
// reversed the way a password hash can be left one-way. See
// src/utils/encryption.js (AES-256-GCM, same ENCRYPTION_KEY already used
// for social account OAuth tokens).
model IntegrationClient {
  id                        String    @id @default(uuid())
  name                      String
  clientId                  String    @unique
  clientSecretEncrypted     String
  // Previous secret, kept encrypted during a rotation's grace period so
  // verifyHmac() can accept requests signed with either secret while the
  // caller (Convo) updates its own ENV — see hmac-auth.middleware.js and
  // scripts/rotate-integration-secret.js. Null outside of an active
  // rotation grace window.
  clientSecretPrevEncrypted String?
  secretRotatedAt           DateTime?
  secretPrevExpiresAt       DateTime?
  // Where PubliCast POSTs HMAC-signed revocation events (user removed from
  // brand / brand deactivated) — see revocation-webhook.service.js.
  // Nullable: a client that only calls verify-token/user-permissions
  // inbound has no reason to also receive outbound webhooks yet.
  webhookUrl                String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  revokedAt                 DateTime?

  @@index([clientId])
  @@map("integration_clients")
}

// Audit trail for IntegrationClient secret rotations — SPEC.md §8. Kept as
// its own append-only table rather than versioning IntegrationClient rows,
// since a rotation is an event to record, not client state to query.
model IntegrationSecretRotationLog {
  id            String   @id @default(uuid())
  clientId      String
  reason        String // 'SCHEDULED' | 'COMPROMISED'
  gracePeriodMs Int
  rotatedAt     DateTime @default(now())
  rotatedBy     String // hostname/user running the CLI script, for accountability

  @@index([clientId])
  @@map("integration_secret_rotation_logs")
}

// ============================================
// BILLING & SUBSCRIPTION
// ============================================

model Plan {
  id              String           @id @default(uuid())
  name            PlanName
  priceAmount     Decimal
  currency        String
  billingCycle    BillingCycle
  description     String?
  planLimitId     String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  pendingPayments PendingPayment[]
  planLimit       PlanLimit        @relation(fields: [planLimitId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  products        Product[]        @relation("PlanProducts")

  @@unique([name, billingCycle])
  @@map("plans")
}

model Platform {
  id        String    @id // e.g. "YT", "FB", "TK"
  name      String    @unique
  color     String    @default("#000000")
  image     String?   @db.LongText // Base64 or URL
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("platforms")
}

model Module {
  id          String    @id // e.g. "M1", "M2"
  name        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("modules")
}

model Product {
  id         String   @id // Uses semantic slug (e.g. 'youtube_analytics' or 'yt_m1')
  name       String   @unique
  category   String // e.g. 'Platforms', 'AI Tools'
  platformId String?
  moduleId   String?
  sku        String?  @unique
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())

  platform Platform? @relation(fields: [platformId], references: [id], onDelete: Cascade)
  module   Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plans    Plan[]    @relation("PlanProducts")

  @@map("products")
}

model PlanLimit {
  id                    String        @id @default(uuid())
  maxBrands             Int
  maxSocialProfiles     Int
  maxPostsPerMonth      Int
  maxLivePlatforms      Int
  maxStreamQuality      StreamQuality
  maxTeamSeats          Int
  allowCustomRoles      Boolean
  allowApprovalWorkflow Boolean
  // How far back (in months) an on-demand published-post fetch looks for a
  // brand on this plan — bounds platforms with no native date-range filter
  // (e.g. TikTok's video/list, which only supports cursor pagination).
  // Deliberately never nullable/unlimited: an old, prolific channel could
  // still mean many sequential API calls to walk even on the highest tier.
  historyWindowMonths   Int           @default(1)
  createdAt             DateTime      @default(now())

  plans Plan[]

  @@map("plan_limits")
}

model Subscription {
  id                   String             @id @default(uuid())
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  plan     Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  brand    Brand?
  addons   SubscriptionAddon[]
  invoices Invoice[]

  @@index([planId])
  @@map("subscriptions")
}

model Addon {
  id            String   @id @default(uuid())
  name          String
  type          String
  priceAmount   Decimal
  currency      String
  value         Int
  stripePriceId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions   SubscriptionAddon[]
  pendingPayments PendingPayment[]

  @@map("addons")
}

model SubscriptionAddon {
  id                       String   @id @default(uuid())
  subscriptionId           String
  addonId                  String
  quantity                 Int
  status                   String   @default("ACTIVE")
  currentPeriodEnd         DateTime
  stripeSubscriptionItemId String?
  createdAt                DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon        Addon        @relation(fields: [addonId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String?

  @@unique([subscriptionId, addonId])
  @@map("subscription_addons")
}

model Invoice {
  id              String    @id @default(uuid())
  subscriptionId  String
  amount          Decimal
  currency        String
  pdfUrl          String
  status          String
  transactionCode String?
  issuedAt        DateTime
  paidAt          DateTime?
  dueAt           DateTime?
  createdAt       DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("invoices")
}

// Tracks VietQR payments before SePay confirms them via webhook
model PendingPayment {
  id              String    @id @default(uuid())
  transactionCode String    @unique // e.g. PUBLICAST-PRO-ABC12345-1719350400000
  planId          String?
  addonId         String?
  addonQuantity   Int?
  brandId         String
  amount          Decimal
  currency        String    @default("VND")
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | UNDERPAID
  expiredAt       DateTime
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  plan  Plan?  @relation(fields: [planId], references: [id])
  addon Addon? @relation(fields: [addonId], references: [id])

  @@index([brandId])
  @@index([status])
  @@map("pending_payments")
}

// ============================================
// SOCIAL MEDIA PLATFORMS
// ============================================

enum SyncStatus {
  PENDING
  PARTIAL
  SUCCESS
  FAILED
}

model SocialAccount {
  id                String       @id @default(uuid())
  brandId           String
  platform          PlatformType
  platformAccountId String
  username          String
  displayName       String
  profilePictureUrl String?      @db.Text
  accessToken       String       @db.Text
  refreshToken      String?      @db.Text
  tokenExpiresAt    DateTime?
  scopes            String       @db.Text
  isConnected       Boolean      @default(true)
  // Display-only hint: pre-checked by default in the post composer when a
  // brand has multiple accounts of the same platform. Not enforced anywhere
  // else (not used for auto-reply routing, dashboard summaries, etc). At
  // most one account per (brandId, platform) should have this true; enforced
  // in application code, not the DB, since Prisma/MySQL can't express a
  // partial unique index here.
  isDefault         Boolean      @default(false)
  connectedAt       DateTime
  lastSyncAt        DateTime?
  syncStatus        SyncStatus   @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  brand                Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  analytics            Analytics[]
  inboxItems           InboxItem[]
  instagramAccount     InstagramAccount?
  facebookPage         FacebookPage?
  tikTokAccount        TikTokAccount?
  youtubeChannel       YouTubeChannel?
  blueskyAccount       BlueskyAccount?
  redditAccount        RedditAccount?
  twitchAccount        TwitchAccount?
  autoReplySetting     AutoReplySetting?
  postNetworkOverrides PostNetworkOverride[]
  postTargets          PostTarget[]
  youtubePlaylistCache YouTubePlaylistCache[]

  // Facebook dedicated metrics
  facebookPostMetrics FacebookPostMetric[] @relation("FacebookPostMetricAccount")

  // Shared post-metrics cache (Instagram, Threads — see SocialPostMetric)
  socialPostMetrics SocialPostMetric[]

  // Per-platform daily channel snapshots — append-only history, one row per
  // account per day (see §2 of the analytics redesign: replaces the
  // "only ever read the latest sync" gap on the overwritten fields above).
  youtubeChannelSnapshots   YouTubeChannelSnapshot[]
  tiktokChannelSnapshots    TikTokChannelSnapshot[]
  instagramChannelSnapshots InstagramChannelSnapshot[]
  threadsChannelSnapshots   ThreadsChannelSnapshot[]
  blueskyChannelSnapshots   BlueskyChannelSnapshot[]
  facebookChannelSnapshots  FacebookChannelSnapshot[]

  // Per-platform post/video metrics — append-only, one row per fetch (not
  // per post), replacing SocialPostMetric's overwrite-on-upsert behavior.
  youtubeVideoMetrics   YouTubeVideoMetric[]
  tiktokVideoMetrics    TikTokVideoMetric[]
  instagramPostMetrics  InstagramPostMetric[]
  threadsPostMetrics    ThreadsPostMetric[]
  blueskyPostMetrics    BlueskyPostMetric[]
  facebookPostMetricsV2 FacebookPostMetricV2[]

  channelGroupMembers ChannelGroupMember[]

  @@unique([brandId, platform, platformAccountId])
  @@index([brandId])
  @@map("social_accounts")
}

// User-organizable grouping of channels within a brand (e.g. "Client A",
// "Video content") — separate from platform type, which is a fixed
// taxonomy. A channel can belong to multiple groups (many-to-many via
// ChannelGroupMember), same shape as Team's brand-scoped membership rows.
//
// visibility controls who can see the group: TEAM (default) is visible to
// every brand member, matching how the rest of the app's brand-scoped data
// works; PRIVATE is visible only to createdByUserId, for a user who wants
// their own scratch organization without cluttering the shared list.
model ChannelGroup {
  id              String                 @id @default(uuid())
  brandId         String
  createdByUserId String
  name            String
  color           String?
  visibility      ChannelGroupVisibility @default(TEAM)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  brand     Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  members   ChannelGroupMember[]

  // A name only needs to be unique within whatever the creator can see it
  // alongside — two different users can each have their own "My Channels"
  // private group without conflicting.
  @@unique([brandId, createdByUserId, name])
  @@index([brandId])
  @@map("channel_groups")
}

enum ChannelGroupVisibility {
  TEAM
  PRIVATE
}

model ChannelGroupMember {
  id              String   @id @default(uuid())
  channelGroupId  String
  socialAccountId String
  createdAt       DateTime @default(now())

  channelGroup  ChannelGroup  @relation(fields: [channelGroupId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([channelGroupId, socialAccountId])
  @@index([socialAccountId])
  @@map("channel_group_members")
}

model YouTubeChannel {
  id                    String  @id @default(uuid())
  socialAccountId       String  @unique
  channelId             String // ID gốc từ YouTube (UCxxxxxxxx)
  customUrl             String? // @handle
  uploadsPlaylistId     String? // ID của playlist chứa video tải lên
  subscribersCount      Int     @default(0)
  totalVideosCount      Int     @default(0)
  totalViewsCount       Int     @default(0)
  country               String?
  defaultLanguage       String?
  isVerified            Boolean @default(false)
  isMonetized           Boolean @default(false)
  supportsShorts        Boolean @default(true)
  madeForKids           Boolean @default(false)
  hiddenSubscriberCount Boolean @default(false)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("youtube_channels")
}

model InstagramAccount {
  id                    String  @id @default(uuid())
  socialAccountId       String  @unique
  // Facebook Page ID linked to this Instagram Business Account — required to
  // call Graph API insights/media endpoints (Instagram Graph API only exposes
  // these via the linked Page node, never via the IG Business Account ID
  // itself). Without this, periodic sync has no way to re-derive the Page ID
  // after the initial connect, since platformAccountId stores the IG account
  // ID (see social-account.repository.js#upsertInstagramAccount).
  facebookPageId        String?
  accountType           String
  businessCategoryName  String?
  followersCount        Int     @default(0)
  followingCount        Int     @default(0)
  mediaCount            Int     @default(0)
  biography             String?
  website               String?
  supportsStories       Boolean @default(false)
  supportsReels         Boolean @default(false)
  supportsCarousels     Boolean @default(false)
  supportsCollaboration Boolean @default(false)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("instagram_accounts")
}

model FacebookPage {
  id              String  @id @default(uuid())
  socialAccountId String  @unique
  pageId          String
  category        String?
  likesCount      Int     @default(0)
  followersCount  Int     @default(0)
  about           String?
  website         String?
  isPublished     Boolean @default(true)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("facebook_pages")
}

model TikTokAccount {
  id                String  @id @default(uuid())
  socialAccountId   String  @unique
  followersCount    Int     @default(0)
  followingCount    Int     @default(0)
  likesCount        Int     @default(0)
  videoCount        Int     @default(0)
  isVerified        Boolean @default(false)
  supportsCarousels Boolean @default(false)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("tiktok_accounts")
}

model BlueskyAccount {
  id              String  @id @default(uuid())
  socialAccountId String  @unique
  did             String  @unique
  handle          String
  pdsUrl          String  @default("https://bsky.social")
  emailConfirmed  Boolean @default(false)
  followersCount  Int     @default(0)
  followsCount    Int     @default(0)
  postsCount      Int     @default(0)
  // OAuth2 DPoP-bound access tokens (AT Protocol) must be re-signed with this
  // ES256 key on every API request — plain Bearer auth is rejected. Stored
  // encrypted (same as accessToken) since dpopPrivateKey is a real private key.
  dpopPrivateKey  String? @db.Text
  dpopJwk         String? @db.Text

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("bluesky_accounts")
}

model RedditAccount {
  id              String @id @default(uuid())
  socialAccountId String @unique
  username        String
  linkKarma       Int    @default(0)
  commentKarma    Int    @default(0)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("reddit_accounts")
}

model TwitchAccount {
  id              String @id @default(uuid())
  socialAccountId String @unique
