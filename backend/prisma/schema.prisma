// ============================================
// FACEBOOK ANALYTICS (Dedicated)
// ============================================

/// Số liệu tổng quan Facebook theo khoảng thời gian.
/// Tab Overview: followers, clicks, reach, impressions (organic vs promoted).
/// Analytics từng bài post Facebook.
/// Tab Posts: Types panel (Group/Count + Views donut chart), List of Posts.
model FacebookPostMetric {
  id              String           @id @default(uuid())
  brandId         String
  socialAccountId String
  platformPostId  String // Facebook post ID
  postType        FacebookPostType // Group trong Types panel
  publishedAt     DateTime?

  // Reach & Impressions (Organic vs Promoted - cho donut chart)
  reach               Int @default(0)
  organicReach        Int @default(0)
  promotedReach       Int @default(0)
  impressions         Int @default(0)
  organicImpressions  Int @default(0)
  promotedImpressions Int @default(0)

  // Views (dành cho Video/Reel)
  videoViews          Int    @default(0)
  organicVideoViews   Int    @default(0)
  promotedVideoViews  Int    @default(0)
  avgWatchTimeSeconds Float? // Thời gian xem trung bình
  watchRate           Float? // % người xem đến cuối video

  // Interactions
  likes           Int @default(0)
  comments        Int @default(0)
  shares          Int @default(0)
  saves           Int @default(0)
  reactions       Int @default(0) // Tổng all reaction types
  linkClicks      Int @default(0)
  otherClicks     Int @default(0)
  negativeActions Int @default(0) // Ẩn bài, hủy theo dõi, báo spam

  // Engagement Rate tổng hợp
  engagementRate Float @default(0)

  // Snapshot để hiển thị danh sách
  captionSnippet String? @db.Text
  thumbnailUrl   String?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation("FacebookPostMetricAccount", fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformPostId])
  @@index([brandId])
  @@index([socialAccountId])
  @@map("facebook_post_metrics")
}

// DB-first cache for published-post metrics on platforms whose insights
// endpoints don't warrant a dedicated per-platform table the way Facebook's
// richer FacebookPostMetric does (no REEL/STANDARD branching, no separate
// reactions-breakdown call) — currently Instagram and Threads. `platform`
// disambiguates within the shared table rather than one model per platform,
// since both write/read the same shape (see instagram-post.service.js /
// threads/index.js's getPublishedPosts DB-first path). Mirrors
// FacebookPostMetric's role: getPublishedPosts reads this before ever
// hitting the live Graph API, only re-fetching live once fetchedAt is
// older than that platform's insights-refresh cadence.
model SocialPostMetric {
  id              String       @id @default(uuid())
  brandId         String
  socialAccountId String
  platform        PlatformType
  platformPostId  String
  postType        String? // platform-specific type string, e.g. IMAGE/VIDEO/CAROUSEL/REEL/STORY — not a shared enum since each platform's set differs
  publishedAt     DateTime?

  reach    Int @default(0)
  views    Int @default(0)
  likes    Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)
  saves    Int @default(0)
  clicks   Int @default(0)

  engagementRate Float @default(0)

  captionSnippet String? @db.Text
  thumbnailUrl   String?
  postUrl        String?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformPostId])
  @@index([brandId])
  @@index([socialAccountId])
  @@map("social_post_metrics")
}

// ============================================
// ANALYTICS REDESIGN — per-platform channel snapshots & post/video metrics
//
// Channel snapshots: one row per socialAccountId per calendar day
// (@@unique([socialAccountId, snapshotDate])), upserted on each sync —
// append-only history instead of the overwrite-only fields on
// YouTubeChannel/TikTokAccount/InstagramAccount/BlueskyAccount/FacebookPage
// above, which stay as-is for fast "latest known value" reads.
//
// Post/video metrics: one row per FETCH (not per post — no unique
// constraint on platformPostId), replacing SocialPostMetric's
// upsert-on-[socialAccountId, platformPostId] overwrite behavior. Separate
// table per platform instead of one shared table, per product decision
// (Instagram and Threads must not share a model).
//
// Telegram is intentionally absent — removed from the product.
// ============================================

model YouTubeChannelSnapshot {
  id              String   @id @default(uuid())
  brandId         String
  socialAccountId String
  snapshotDate    DateTime @db.Date

  subscribersCount  Int @default(0)
  totalViewsCount   Int @default(0)
  totalVideosCount  Int @default(0)
  subscribersGained Int @default(0)
  subscribersLost   Int @default(0)

  // Demographics/traffic-source/geography/search-terms — not per-day counters,
  // kept as the raw blob for whichever day this snapshot covers.
  rawInsightsJson String? @db.LongText

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, snapshotDate])
  @@index([brandId])
  @@index([socialAccountId, snapshotDate])
  @@map("youtube_channel_snapshots")
}

model TikTokChannelSnapshot {
