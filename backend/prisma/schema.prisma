  TRIALING
  PAST_DUE
  CANCELLED
  UNPAID
}

enum StreamQuality {
  SD
  HD_720P
  FHD_1080P
  UHD_4K
}

enum PlatformType {
  INSTAGRAM
  FACEBOOK
  TIKTOK
