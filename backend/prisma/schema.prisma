/// Số liệu tổng quan Facebook theo khoảng thời gian.
/// Tab Overview: followers, clicks, reach, impressions (organic vs promoted).
model FacebookOverviewMetric {
  id              String   @id @default(uuid())
  brandId         String
  socialAccountId String
  dateFrom        DateTime
  dateTo          DateTime
  granularity     String   @default("DAY") // DAY | WEEK | MONTH

  // Followers
  followersTotal     Int @default(0)
  followersGain      Int @default(0)
  followersLost      Int @default(0)
  followersNetChange Int @default(0)

  // Reach & Impressions (chia organic/promoted)
  reach              Int @default(0)
  impressions        Int @default(0)
  organicReach       Int @default(0)
  paidReach          Int @default(0)
  organicImpressions Int @default(0)
  paidImpressions    Int @default(0)

  // Clicks
  pageClicks  Int @default(0) // Tổng click trên page
  linkClicks  Int @default(0) // Click vào link trong post
  otherClicks Int @default(0) // Click profile, phone, direction...

  // Engagement
  engagements Int @default(0)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  reactions   Int @default(0) // Tổng reactions (all types)

  // Page Views
  pageViews       Int @default(0)
  uniquePageViews Int @default(0)

  // Video
  videoViews        Int @default(0)
  organicVideoViews Int @default(0)
  paidVideoViews    Int @default(0)

  // Dữ liệu breakdown theo ngày (JSON array)
  dailyBreakdownJson String? @db.LongText

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation("FacebookOverviewMetricAccount", fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([socialAccountId])
  @@map("facebook_overview_metrics")
}

/// Analytics từng bài post Facebook.
/// Tab Posts: Types panel (Group/Count + Views donut chart), List of Posts.
model FacebookPostMetric {
  id              String           @id @default(uuid())
  brandId         String
  socialAccountId String
  platformPostId  String // Facebook post ID
  postType        FacebookPostType // Group trong Types panel
  publishedAt     DateTime?

  // Reach & Impressions (Organic vs Promoted - cho donut chart)
  reach               Int @default(0)
  organicReach        Int @default(0)
  promotedReach       Int @default(0)
  impressions         Int @default(0)
  organicImpressions  Int @default(0)
  promotedImpressions Int @default(0)

  // Views (dành cho Video/Reel)
  videoViews          Int    @default(0)
  organicVideoViews   Int    @default(0)
  promotedVideoViews  Int    @default(0)
  avgWatchTimeSeconds Float? // Thời gian xem trung bình
  watchRate           Float? // % người xem đến cuối video

  // Interactions
  likes           Int @default(0)
  comments        Int @default(0)
  shares          Int @default(0)
  saves           Int @default(0)
  reactions       Int @default(0) // Tổng all reaction types
  linkClicks      Int @default(0)
  otherClicks     Int @default(0)
  negativeActions Int @default(0) // Ẩn bài, hủy theo dõi, báo spam

  // Engagement Rate tổng hợp
  engagementRate Float @default(0)

  // Snapshot để hiển thị danh sách
  captionSnippet String? @db.Text
  thumbnailUrl   String?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation("FacebookPostMetricAccount", fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformPostId])
  @@index([brandId])
  @@index([socialAccountId])
  @@map("facebook_post_metrics")
}

/// Analytics từng Facebook Story.
/// Tab Stories: danh sách stories + metrics reach/exits/replies/completion.
model FacebookStoryMetric {
  id              String    @id @default(uuid())
  brandId         String
  socialAccountId String
  platformStoryId String // Facebook story ID
  publishedAt     DateTime?
  expiresAt       DateTime?

  // Media
  mediaType    String  @default("IMAGE") // IMAGE | VIDEO
  thumbnailUrl String?
  mediaUrl     String?

  // Reach & Impressions
  reach       Int @default(0)
  impressions Int @default(0)

  // Story-specific metrics
  exits          Int    @default(0) // Người dùng thoát khỏi story
  replies        Int    @default(0) // Replies qua Direct Message
  tapsForward    Int    @default(0) // Tap xem story tiếp theo
  tapsBack       Int    @default(0) // Tap xem lại story trước
  linkClicks     Int    @default(0) // Swipe-up / link sticker clicks
  completionRate Float? // % người xem đến hết story
  exitRate       Float? // % exits / impressions

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation("FacebookStoryMetricAccount", fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformStoryId])
  @@index([brandId])
  @@index([socialAccountId])
  @@map("facebook_story_metrics")
}

