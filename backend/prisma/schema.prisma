  brandId           String
  createdByUserId   String
  title             String
  description       String?      @db.Text
  dateFrom          DateTime
  dateTo            DateTime
  includedPlatforms String       @db.Text
  includedSections  String       @db.Text
  isWhiteLabel      Boolean      @default(false)
  brandLogoUrl      String?
  brandColorHex     String?
  format            ReportFormat
  fileUrl           String?
