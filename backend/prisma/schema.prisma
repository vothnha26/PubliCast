// ============================================
// CONTENT MANAGEMENT
// ============================================

model Post {
  id                 String                 @id @default(uuid())
  brandId            String
  createdByUserId    String
  title              String
  caption            String?                @db.Text
  type               PostType
  status             PostStatus             @default(DRAFT)
  // Persisted count of self-enqueued partial-retry rounds (mirrors the
  // in-memory partialRetryCount that only lives in BullMQ job.data — if that
  // job is ever lost (Redis restart, or the #106 active-job dedup skipping a
  // re-enqueue), this is what the RETRYING reconciler sweeper reads to decide
  // whether to re-enqueue again or give up as FAILED (#107 I7).
  publishRetryCount  Int                    @default(0)
  targetPlatforms    String                 @db.Text
  mediaUrls          String?                @db.Text
  mediaThumbnailUrls String?                @db.Text
  hashtags           String?                @db.Text
  mentions           String?                @db.Text
  firstComment       String?                @db.Text
  locationId         String?
  locationName       String?
  linkUrl            String?
  altText            String?
  metadata           String?                @db.Text
  isCollaboration    Boolean                @default(false)
  collaboratorHandle String?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  failureReason      String?                @db.Text
  autoListId         String?
  platformPostId     String?
  // QStash messageId for the currently-scheduled/in-flight publish delivery
  // (replaces BullMQ's jobId-based remove/re-add) — lets upsertPublishJob and
  // removePublishJob cancel a specific pending delivery via
  // client.messages.delete() when a post is rescheduled or unscheduled.
  qstashMessageId    String?
  isLibrary          Boolean                @default(false)
  // Only meaningful when isLibrary is true — TEAM: visible to every brand
  // member's Post Library. PRIVATE: only the creator sees it. Mirrors
  // ChannelGroupVisibility's semantics (see that enum), reused here rather
  // than duplicated since the meaning is identical.
  libraryVisibility  ChannelGroupVisibility @default(TEAM)
  isDeleted          Boolean                @default(false)
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator           User               @relation("PostCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  autoList          AutoList?          @relation(fields: [autoListId], references: [id], onDelete: Cascade)
  approvalWorkflows ApprovalWorkflow[]

  networkOverrides PostNetworkOverride[]
  targets          PostTarget[]

  @@index([brandId])
  @@index([createdByUserId])
  @@map("posts")
}

// Which SocialAccount(s) a Post is/was published to — the single source of
// truth for account targeting, independent of PostNetworkOverride (which is
// content-customization only, and only exists for accounts where the
// composer's "edit by network" was turned on). One row per targeted account,
// written whenever a post is created/updated, regardless of whether that
// account's content was customized. Channel filters, the publish step, and
// delete-on-platform calls all resolve "which account(s)" from this table.
model PostTarget {
  id              String           @id @default(uuid())
  postId          String
  platform        PlatformType
  socialAccountId String
  // Per-target publish outcome, written by SocialPublishStep as each
  // (platform, account) publish call actually resolves — lets the UI show
  // real "N/M platforms published" progress instead of only the Post's
  // single aggregate status, which can't distinguish "still publishing" from
  // "half-published" across independently-completing platform calls.
  publishStatus   PostTargetStatus @default(PENDING)
  publishedAt     DateTime?
  errorMessage    String?

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@index([socialAccountId])
  @@map("post_targets")
}

enum PostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

// Per-platform (and, when a brand has multiple accounts of that platform,
// per-account) caption/media override for a Post whose composer had "edit by
// network" customization enabled. socialAccountId is null for brands with a
// single account of the platform (the common case today) — the row then
// applies to that one implicit account. When a brand has multiple accounts
// of the same platform, one row per selected account may exist, each with
// its own socialAccountId, so captions can be edited independently per
// channel; a row with useTemplate=true (or its absence) means publish falls
// back to the shared Post.caption/mediaUrls, exactly as before this model
// existed — this table only ever adds an optional override layer, it never
// replaces Post as the single calendar/approval unit.
model PostNetworkOverride {
  id              String       @id @default(uuid())
  postId          String
  platform        PlatformType
  socialAccountId String?
  useTemplate     Boolean      @default(true)
  caption         String?      @db.Text
  mediaUrls       String?      @db.Text
  // THREADS only: JSON array of {text, mediaUrls} for the reply chain,
  // parallel to draft.networkCustom.THREADS.threadPosts on the frontend.
  threadPosts     String?      @db.Text
  // JSON object of platform-specific technical fields for this account —
  // YouTube's {categoryId, privacyStatus, tags, madeForKids, playlistId},
  // TikTok's {privacy, allowComments, allowDuet, allowStitch, aiGenerated,
  // commercialContent}, etc. Only populated when useTemplate=false; publish
  // merges it into the post's shared `options` for this (platform, account)
  // pair (see SocialPublishStep). Before this column, every account of a
  // platform shared one flat category/privacy/tags value regardless of
  // which specific channel was selected — a brand with 2 YouTube channels
  // could not give them different categories.
  settings        String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, platform, socialAccountId])
  @@map("post_network_overrides")
}

