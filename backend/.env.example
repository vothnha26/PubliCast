# ============================================================
# PubliCast Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL via Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set to 'true' to use in-memory Redis fallback (development/test only)
USE_MEMORY_REDIS=false
# Only set to 'true' if your rediss:// provider uses a self-signed cert you
# cannot otherwise get verified — this disables TLS certificate verification.
REDIS_TLS_ALLOW_SELF_SIGNED=false

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# JWT Configuration (use strong random secrets — min 32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_SECRET=REPLACE_WITH_STRONG_ACCESS_SECRET_MIN_32_CHARS
REFRESH_TOKEN_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET_MIN_32_CHARS

# Field-level encryption (social OAuth tokens, etc — min 32 chars)
ENCRYPTION_KEY=REPLACE_WITH_STRONG_ENCRYPTION_KEY_MIN_32_CHARS

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:5173
# Comma-separated list of production origins (e.g. https://app.example.com)
CORS_ALLOWED_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Threads OAuth (falls back to FACEBOOK_APP_ID/SECRET if unset)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=publicast/1.0 by your_reddit_username
REDDIT_REDIRECT_URI=http://localhost:3000/api/social/reddit/callback

# Twitch OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Bluesky OAuth Configuration
BLUESKY_CLIENT_ID=http://localhost:3000/api/social/bluesky/callback
BLUESKY_OAUTH_HOST=https://bsky.app
BLUESKY_OAUTH_TOKEN_URL=https://bsky.social/oauth/token

# Stock Media Providers
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
APP_NAME=PubliCast

# Backend Base URL (for OAuth redirect URIs, ngrok in dev)
BACKEND_BASE_URL=http://localhost:3000

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to 'cloudinary' or 'local' — controls where uploaded media is stored
UPLOAD_STORAGE=cloudinary

# AI Providers (transcription, hashtag suggestions, etc.)
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_URL_TEMPLATE=

# RapidAPI (TikTok hashtag provider)
RAPIDAPI_KEY=

# Cloudflare (CDN cache purge for /v2/templates on template writes)
# Token scope: Zone > Cache Purge > Purge, restricted to the publicast.app zone
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Help Center (RAG) — separate PostgreSQL + pgvector database, isolated from
# the main MySQL DATABASE_URL above. Uses its own Prisma schema/client
# (prisma/help-center/schema.prisma). See docker-compose.yml "postgres-helpcenter".
HELP_CENTER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/publicast_help_center"
# NOTE: Help Center embeddings always use OpenAI (text-embedding-3-small),
# even when AI_PROVIDER=GEMINI for chat/answer generation — so
# OPENAI_API_KEY above is required for this feature regardless of AI_PROVIDER.

# Email Delivery — Resend (preferred) or SMTP fallback via nodemailer
RESEND_API_KEY=
RESEND_SENDER=

# System Constants
SOCIAL_SYNC_COOLDOWN_HOURS=2
TOKEN_REFRESH_LOOKHEAD_DAYS=
TOKEN_REFRESH_INTERVAL_MS=
TOKEN_REFRESH_STARTUP_DELAY_MS=

# Worker-only endpoints (internal shared secret, e.g. AI highlight callbacks)
WORKER_SECRET=

# =============================================
# PAYMENT & BILLING
# =============================================
PAYMENT_GATEWAY="vietqr"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
VIETQR_ACQ_ID="970422"
VIETQR_TEMPLATE="compact2"
SEPAY_API_KEY=""
PAYMENT_QR_EXPIRY_MINUTES=15
