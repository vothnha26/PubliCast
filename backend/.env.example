# ============================================================
# PubliCast Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL via Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set to 'true' to use in-memory Redis fallback (development/test only)
USE_MEMORY_REDIS=false
# Only set to 'true' if your rediss:// provider uses a self-signed cert you
# cannot otherwise get verified — this disables TLS certificate verification.
REDIS_TLS_ALLOW_SELF_SIGNED=false

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# JWT Configuration (use strong random secrets — min 32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_SECRET=REPLACE_WITH_STRONG_ACCESS_SECRET_MIN_32_CHARS
REFRESH_TOKEN_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET_MIN_32_CHARS

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:5173
# Comma-separated list of production origins (e.g. https://app.example.com)
CORS_ALLOWED_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Backend Base URL (for OAuth redirect URIs, ngrok in dev)
BACKEND_BASE_URL=http://localhost:3000

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# System Constants
SOCIAL_SYNC_COOLDOWN_HOURS=2

# =============================================
# PAYMENT & BILLING
# =============================================
PAYMENT_GATEWAY="vietqr"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
VIETQR_ACQ_ID="970422"
VIETQR_TEMPLATE="compact2"
SEPAY_API_KEY=""
PAYMENT_QR_EXPIRY_MINUTES=15
